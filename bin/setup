#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/_env.sh"

if ! bundle "_${BUNDLER_VERSION}_" --version >/dev/null 2>&1; then
  gem install bundler -v "$BUNDLER_VERSION" --user-install
fi

bundle_cmd config set --local path "vendor/bundle"
if ! bundle_cmd check >/dev/null 2>&1; then
  bundle_cmd install
fi
